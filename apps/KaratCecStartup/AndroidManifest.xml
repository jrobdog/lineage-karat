<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.karat.cecstartup"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.HDMI_CEC" />
    <application android:label="HDMI startup" android:allowBackup="false">
        <receiver android:name=".StartupReceiver" android:exported="true"
            android:permission="android.permission.HDMI_CEC">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <activity android:name=".EnableActivity" android:exported="true"
            android:permission="android.permission.HDMI_CEC"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
